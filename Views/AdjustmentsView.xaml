<UserControl x:Class="HR_ERP.Views.AdjustmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Label x:Name="MonthLabel" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonthBox" Width="100" VerticalAlignment="Center" SelectionChanged="MonthBox_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="AdjustmentsGrid" Grid.Row="1" IsReadOnly="True" FrozenColumnCount="2"
                  CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="Bonus">
                            <Setter Property="Background" Value="{StaticResource StatusHolidayBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Incentive">
                            <Setter Property="Background" Value="{StaticResource StatusLeaveBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Penalty">
                            <Setter Property="Background" Value="{StaticResource StatusAbsentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColCode" Binding="{Binding EmployeeCode}" Width="80"/>
                <DataGridTextColumn x:Name="ColEmployee" Binding="{Binding EmployeeName}" Width="160"/>
                <DataGridTextColumn x:Name="ColType" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn x:Name="ColAmount" Binding="{Binding Amount, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColDescription" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn x:Name="ColCreated" Binding="{Binding CreatedDate, StringFormat=g}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
            <StackPanel>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <Label x:Name="EmployeeLabel"/>
                        <ComboBox x:Name="EmployeeBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="TypeLabel"/>
                        <!-- Values here are stored and matched as literal text (the row-color
                             triggers above), so they're kept in English regardless of UI
                             language - only the field label is translated. -->
                        <ComboBox x:Name="TypeBox">
                            <ComboBoxItem Content="Bonus"/>
                            <ComboBoxItem Content="Incentive"/>
                            <ComboBoxItem Content="Penalty"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="AmountLabel"/>
                        <TextBox x:Name="AmountBox" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="DescriptionLabel"/>
                        <TextBox x:Name="DescriptionBox"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="NoteText"
                           Foreground="Gray" FontStyle="Italic" FontSize="11.5" Margin="4,4,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Click="Add_Click" Background="#2ECC71" Foreground="White"/>
                    <Button x:Name="DeleteButton" Click="Delete_Click" Background="#E74C3C" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
