<Window x:Class="HR_ERP.Views.PayslipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payslip" Height="720" Width="650" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{StaticResource BrandPrimary}" Margin="0">
            <Button Content="🖨  Print" Click="Print_Click" Background="{StaticResource BrandAccent}" Foreground="White" Margin="10"/>
            <Button Content="Close" Click="Close_Click" Margin="10"/>
        </StackPanel>

        <FlowDocumentScrollViewer Grid.Row="1" x:Name="Viewer" VerticalScrollBarVisibility="Auto" Padding="20" Zoom="100"/>
    </Grid>
</Window>
