<Window x:Class="HR_ERP.Views.DocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Viewer" Height="720" Width="820" WindowStartupLocation="CenterOwner">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: rename / description, editable in place -->
        <Border Grid.Row="0" Background="{StaticResource BrandPrimary}" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="File Name:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="FileNameBox" Width="320" Margin="0,0,10,0"/>
                    <Button Content="💾  Save Changes" Click="Save_Click" Background="#27AE60" Foreground="White"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Category:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CategoryBox" Width="260" Margin="0,0,10,0" DisplayMemberPath="Display"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Description:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="DescriptionBox" Width="500"/>
                </StackPanel>
                <TextBlock x:Name="MetaText" Foreground="#CBD6E0" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body: swapped based on file type -->
        <Grid Grid.Row="1" x:Name="ViewerHost" Margin="0">
            <Image x:Name="ImageViewer" Stretch="Uniform" Visibility="Collapsed" Margin="16"/>
            <TextBox x:Name="TextViewer" Visibility="Collapsed" IsReadOnly="True" TextWrapping="NoWrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Margin="16" Background="White"/>
            <WebBrowser x:Name="PdfViewer" Visibility="Collapsed" Margin="0"/>
            <StackPanel x:Name="UnsupportedPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="UnsupportedText" FontSize="14" Foreground="Gray" TextAlignment="Center" TextWrapping="Wrap" Width="400"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
