<UserControl x:Class="HR_ERP.Views.LeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1">
            <TabItem x:Name="RequestsTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="LeaveGrid" Grid.Row="0" IsReadOnly="True" FrozenColumnCount="2"
                              CanUserAddRows="False" SelectionChanged="LeaveGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                        <Setter Property="Background" Value="{StaticResource StatusHolidayBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                        <Setter Property="Background" Value="{StaticResource StatusLateBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                        <Setter Property="Background" Value="{StaticResource StatusAbsentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColCode" Binding="{Binding EmpCode}" Width="80"/>
                            <DataGridTextColumn x:Name="ColEmployee" Binding="{Binding EmplName}" Width="160"/>
                            <DataGridTextColumn x:Name="ColType" Binding="{Binding LeaveType}" Width="140"/>
                            <DataGridTextColumn x:Name="ColStart" Binding="{Binding StartDate, StringFormat=d}" Width="100"/>
                            <DataGridTextColumn x:Name="ColEnd" Binding="{Binding EndDate, StringFormat=d}" Width="100"/>
                            <DataGridTextColumn x:Name="ColReason" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn x:Name="ColStatus" Binding="{Binding Status}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <Label x:Name="EmployeeLabel"/>
                                    <ComboBox x:Name="EmployeeBox" DisplayMemberPath="Name" SelectionChanged="BalanceCheckTrigger_Changed"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label x:Name="TypeLabel"/>
                                    <!-- Values here are stored and matched as literal text (payroll,
                                         attendance and reporting all compare against them), so they're
                                         kept in English regardless of UI language - only the field label
                                         above is translated. -->
                                    <ComboBox x:Name="LeaveTypeBox" SelectionChanged="BalanceCheckTrigger_Changed">
                                        <ComboBoxItem Content="Annual Leave"/>
                                        <ComboBoxItem Content="Sick Leave"/>
                                        <ComboBoxItem Content="Unpaid Leave"/>
                                        <ComboBoxItem Content="Maternity/Paternity Leave"/>
                                        <ComboBoxItem Content="Official Mission"/>
                                        <ComboBoxItem Content="Departure Permit"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <Label x:Name="StartDateLabel"/>
                                    <DatePicker x:Name="StartDatePicker" SelectedDateChanged="BalanceCheckTrigger_Changed"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label x:Name="EndDateLabel"/>
                                    <DatePicker x:Name="EndDatePicker" SelectedDateChanged="BalanceCheckTrigger_Changed"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="RemainingBalanceText" FontWeight="SemiBold" FontSize="12" Margin="4,6,0,0" Visibility="Collapsed"/>
                            <Label x:Name="ReasonLabel"/>
                            <TextBox x:Name="ReasonBox"/>
                            <TextBlock x:Name="PaidNoteText"
                                       Foreground="Gray" FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="4,6,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="NewButton" Click="New_Click"/>
                                <Button x:Name="SubmitButton" Click="Submit_Click" Background="#3498DB" Foreground="White"/>
                                <Button x:Name="ApproveButton" Click="Approve_Click" Background="#2ECC71" Foreground="White"/>
                                <Button x:Name="RejectButton" Click="Reject_Click" Background="#E67E22" Foreground="White"/>
                                <Button x:Name="DeleteButton" Click="Delete_Click" Background="#E74C3C" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="BalanceExpander" Grid.Row="2"
                              IsExpanded="False" Margin="0,10,0,0" Expanded="BalanceExpander_Expanded">
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="BalanceNoteText"
                                           Foreground="Gray" FontStyle="Italic" FontSize="11.5" VerticalAlignment="Center"/>
                                <Button x:Name="BalanceRefreshButton" Click="BalanceRefresh_Click" Margin="16,0,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="BalanceGrid" Height="220" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColBalCode" Binding="{Binding EmployeeCode}" Width="80"/>
                                    <DataGridTextColumn x:Name="ColBalEmployee" Binding="{Binding EmployeeName}" Width="160"/>
                                    <DataGridTextColumn x:Name="ColBalEntitlement" Binding="{Binding Entitlement}" Width="120"/>
                                    <DataGridTextColumn x:Name="ColBalCarriedOver" Binding="{Binding CarriedOver}" Width="110"/>
                                    <DataGridTextColumn x:Name="ColBalTotalAvailable" Binding="{Binding TotalAvailable}" Width="120"/>
                                    <DataGridTextColumn x:Name="ColBalUsedThisYear" Binding="{Binding UsedThisYear}" Width="120"/>
                                    <DataGridTextColumn x:Name="ColBalRemaining" Binding="{Binding RemainingBalance}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem x:Name="HolidaysTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="HolidaysGrid" Grid.Row="0" IsReadOnly="True" FrozenColumnCount="1"
                              CanUserAddRows="False" SelectionChanged="HolidaysGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColHolidayDate" Binding="{Binding HolidayDate, StringFormat=d}" Width="120"/>
                            <DataGridTextColumn x:Name="ColHolidayDescription" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <Label x:Name="HolidayDateLabel"/>
                                    <DatePicker x:Name="HolidayDatePicker"/>
                                </StackPanel>
                                <StackPanel>
                                    <Label x:Name="HolidayDescriptionLabel"/>
                                    <TextBox x:Name="HolidayDescriptionBox"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="HolidayNewButton" Click="HolidayNew_Click"/>
                                <Button x:Name="HolidaySaveButton" Click="HolidaySave_Click" Background="#2ECC71" Foreground="White"/>
                                <Button x:Name="HolidayDeleteButton" Click="HolidayDelete_Click" Background="#E74C3C" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
