<UserControl x:Class="HR_ERP.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Label x:Name="MonthLabel" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonthBox" Width="100" VerticalAlignment="Center"/>
            <Button x:Name="AutoGenerateButton" Click="AutoGenerate_Click" Background="#8E44AD" Foreground="White" Margin="20,4,4,4"/>
        </StackPanel>

        <DataGrid x:Name="PayrollGrid" Grid.Row="1" IsReadOnly="True" FrozenColumnCount="2"
                  CanUserAddRows="False" SelectionChanged="PayrollGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                            <Setter Property="Background" Value="{StaticResource StatusHolidayBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                            <Setter Property="Background" Value="{StaticResource StatusLateBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColCode" Binding="{Binding EmployeeCode}" Width="80"/>
                <DataGridTextColumn x:Name="ColEmployee" Binding="{Binding EmployeeName}" Width="150"/>
                <DataGridTextColumn x:Name="ColPeriodStart" Binding="{Binding PayPeriodStart, StringFormat=d}" Width="100"/>
                <DataGridTextColumn x:Name="ColPeriodEnd" Binding="{Binding PayPeriodEnd, StringFormat=d}" Width="100"/>
                <DataGridTextColumn x:Name="ColBasic" Binding="{Binding BasicSalary, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColAllowances" Binding="{Binding Allowances, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColDeductions" Binding="{Binding Deductions, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColOtAmount" Binding="{Binding OvertimeAmount, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColNetSalary" Binding="{Binding NetSalary, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn x:Name="ColStatus" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
            <StackPanel>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <Label x:Name="EmployeeLabel"/>
                        <ComboBox x:Name="EmployeeBox" DisplayMemberPath="FullName" SelectionChanged="EmployeeBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="PeriodStartLabel"/>
                        <DatePicker x:Name="PeriodStartPicker"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="PeriodEndLabel"/>
                        <DatePicker x:Name="PeriodEndPicker"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="BasicSalaryLabel"/>
                        <TextBox x:Name="BasicSalaryBox"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <Label x:Name="AllowancesLabel"/>
                        <TextBox x:Name="AllowancesBox" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="DeductionsLabel"/>
                        <TextBox x:Name="DeductionsBox" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="OvertimeHoursLabel"/>
                        <TextBox x:Name="OvertimeHoursBox" Text="0"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="OvertimeAmountLabel"/>
                        <TextBox x:Name="OvertimeAmountBox" Text="0"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Click="New_Click"/>
                    <Button x:Name="SaveManualButton" Click="Generate_Click" Background="#3498DB" Foreground="White"/>
                    <Button x:Name="MarkPaidButton" Click="MarkPaid_Click" Background="#2ECC71" Foreground="White"/>
                    <Button x:Name="PrintPayslipButton" Click="PrintPayslip_Click" Background="#16A085" Foreground="White"/>
                    <Button x:Name="DeleteButton" Click="Delete_Click" Background="#E74C3C" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
