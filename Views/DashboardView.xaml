<UserControl x:Class="HR_ERP.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="CardNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
        </Style>
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="HeaderText" Text="Dashboard" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="TodayText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                <Button x:Name="RefreshButton" Content="⟳  Refresh" Click="Refresh_Click" Margin="16,0,0,0"/>
            </StackPanel>

            <!-- KPI cards -->
            <UniformGrid Columns="4" Rows="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TotalEmployeesText" Style="{StaticResource CardNumberStyle}"/>
                        <TextBlock x:Name="ActiveEmployeesLabel" Text="Active Employees" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="PresentTodayText" Style="{StaticResource CardNumberStyle}" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock x:Name="PresentTodayLabel" Text="Present Today" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="LateTodayText" Style="{StaticResource CardNumberStyle}" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="LateTodayLabel" Text="Late Today" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AbsentTodayText" Style="{StaticResource CardNumberStyle}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock x:Name="AbsentTodayLabel" Text="Absent Today" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="OnLeaveTodayText" Style="{StaticResource CardNumberStyle}"/>
                        <TextBlock x:Name="OnLeaveTodayLabel" Text="On Leave Today" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="PendingLeaveText" Style="{StaticResource CardNumberStyle}"/>
                        <TextBlock x:Name="PendingLeaveLabel" Text="Pending Leave Requests" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="DepartmentsText" Style="{StaticResource CardNumberStyle}"/>
                        <TextBlock x:Name="DepartmentsLabel" Text="Departments" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="MonthPayrollText" Style="{StaticResource CardNumberStyle}" FontSize="20"/>
                        <TextBlock x:Name="MonthPayrollLabelText" Text="This Month's Net Payroll" Style="{StaticResource CardLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Department headcount -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock x:Name="HeadcountLabel" Text="Headcount by Department" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="DepartmentBarsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                                        <Border Grid.Row="1" Height="10" CornerRadius="3" Background="#E9EEF3" Margin="0,3,0,0">
                                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" Height="10"
                                                    CornerRadius="3" Background="{StaticResource BrandAccent}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Upcoming holidays + pending leave -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="UpcomingHolidaysLabel" Text="Upcoming Holidays" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="UpcomingHolidaysList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" FontSize="12.5">
                                            <Run Text="{Binding DateText}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Description}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoHolidaysText" Text="No upcoming holidays." Foreground="Gray" FontStyle="Italic" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="PendingLeaveHeaderText" Text="Pending Leave Requests" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="PendingLeaveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" FontSize="12.5">
                                            <Run Text="{Binding EmplName}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding LeaveType}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding DateRangeText}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoPendingLeaveText" Text="No pending leave requests." Foreground="Gray" FontStyle="Italic" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
