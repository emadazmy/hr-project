<UserControl x:Class="HR_ERP.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl x:Name="SettingsTabs" Grid.Row="1">

            <!-- ===================== Users tab ===================== -->
            <TabItem x:Name="UsersTab" Header="Users">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionChanged="UsersGrid_SelectionChanged"
                              FrozenColumnCount="1" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="160"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="120"/>
                            <DataGridTextColumn Header="Employee Code" Binding="{Binding EmployeeCode}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                            <DataGridTextColumn Header="Last Login" Binding="{Binding LastLogin, StringFormat=g}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="UserUsernameLabel" Text="Username"/>
                                <TextBox x:Name="UserUsernameBox"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="UserFullNameLabel" Text="Full Name"/>
                                <TextBox x:Name="UserFullNameBox"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="UserRoleLabel" Text="Role"/>
                                <ComboBox x:Name="UserRoleBox" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="UserEmployeeLabel" Text="Linked Employee (optional)"/>
                                <ComboBox x:Name="UserEmployeeBox" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </UniformGrid>
                        <CheckBox x:Name="UserActiveBox" IsChecked="True" Margin="4,8,4,0"/>

                        <StackPanel x:Name="PasswordPanel" Margin="0,6,0,0">
                            <TextBlock x:Name="UserPasswordLabel" Text="Password"/>
                            <PasswordBox x:Name="UserPasswordBox"/>
                            <TextBlock x:Name="PasswordHintText" Text="Set on new users; leave blank when editing an existing user (use Reset Password to change it)."
                                       FontSize="11" Foreground="Gray" FontStyle="Italic" Margin="4,2,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="UserNewButton" Content="New" Click="UserNew_Click"/>
                            <Button x:Name="UserResetPasswordButton" Content="Reset Password" Click="UserResetPassword_Click"/>
                            <Button x:Name="UserSaveButton" Content="Save" Click="UserSave_Click" Background="#2ECC71" Foreground="White"/>
                            <Button x:Name="UserDeleteButton" Content="Delete" Click="UserDelete_Click" Background="#E74C3C" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Roles & Permissions tab ===================== -->
            <TabItem x:Name="RolesTab" Header="Roles &amp; Permissions">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Roles list + edit -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="RolesGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionChanged="RolesGrid_SelectionChanged" MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock x:Name="RoleNameLabel" Text="Role Name"/>
                            <TextBox x:Name="RoleNameBox"/>
                            <TextBlock x:Name="RoleDescriptionLabel" Text="Description" Margin="0,6,0,0"/>
                            <TextBox x:Name="RoleDescriptionBox" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="RoleNewButton" Content="New" Click="RoleNew_Click"/>
                                <Button x:Name="RoleSaveButton" Content="Save" Click="RoleSave_Click" Background="#2ECC71" Foreground="White"/>
                                <Button x:Name="RoleDeleteButton" Content="Delete" Click="RoleDelete_Click" Background="#E74C3C" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Permission matrix for the selected role -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MatrixHintText" Grid.Row="0"
                                   Text="Select a role on the left to view or change what it can access."
                                   FontStyle="Italic" Foreground="Gray" Margin="0,0,0,8"/>
                        <DataGrid x:Name="PermissionsGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" MinHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Can View" Binding="{Binding CanView}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Can Add/Edit/Delete" Binding="{Binding CanEdit}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="SavePermissionsButton" Content="Save Permissions" Click="SavePermissions_Click"
                                    Background="{StaticResource BrandAccent}" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== Language tab ===================== -->
            <TabItem x:Name="LanguageTab" Header="Language">
                <StackPanel Margin="0,20,0,0" MaxWidth="380" HorizontalAlignment="Left">
                    <TextBlock x:Name="LanguagePromptText" Text="Choose the application language:" FontSize="14" Margin="0,0,0,12"/>
                    <RadioButton x:Name="EnglishRadio" Content="English" GroupName="Lang" FontSize="14" Margin="0,0,0,8" Checked="LanguageRadio_Checked"/>
                    <RadioButton x:Name="ArabicRadio" Content="العربية (Arabic)" GroupName="Lang" FontSize="14" Margin="0,0,0,8" Checked="LanguageRadio_Checked"/>
                    <TextBlock x:Name="RestartNoteText" Text="Takes effect immediately — no restart needed."
                               FontSize="11" Foreground="Gray" FontStyle="Italic" Margin="0,4,0,16"/>
                    <Button x:Name="ApplyLanguageButton" Content="Apply" Click="ApplyLanguage_Click"
                            Background="{StaticResource BrandAccent}" Foreground="White" HorizontalAlignment="Left" Padding="18,8"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
