<UserControl x:Class="HR_ERP.Views.CashAdvancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Label x:Name="AsOfLabel" VerticalAlignment="Center"/>
            <ComboBox x:Name="AsOfMonthBox" Width="100" VerticalAlignment="Center" SelectionChanged="AsOfMonthBox_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="AdvancesGrid" Grid.Row="1" IsReadOnly="True" FrozenColumnCount="2"
                  CanUserAddRows="False" SelectionChanged="AdvancesGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                            <Setter Property="Background" Value="{StaticResource StatusHolidayBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColCode" Binding="{Binding EmployeeCode}" Width="80"/>
                <DataGridTextColumn x:Name="ColEmployee" Binding="{Binding EmployeeName}" Width="150"/>
                <DataGridTextColumn x:Name="ColAmount" Binding="{Binding Amount, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColInstallments" Binding="{Binding Installments}" Width="90"/>
                <DataGridTextColumn x:Name="ColMonthly" Binding="{Binding MonthlyDeduction, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn x:Name="ColStartMonth" Binding="{Binding StartMonth}" Width="95"/>
                <DataGridTextColumn x:Name="ColPaidSoFar" Binding="{Binding PaidDisplay}" Width="100"/>
                <DataGridTextColumn x:Name="ColRemaining" Binding="{Binding RemainingDisplay}" Width="100"/>
                <DataGridTextColumn x:Name="ColStatus" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
            <StackPanel>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <Label x:Name="EmployeeLabel"/>
                        <ComboBox x:Name="EmployeeBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="TotalAmountLabel"/>
                        <TextBox x:Name="AmountBox" Text="0" LostFocus="RecalculateMonthly_LostFocus"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="InstallmentsLabel"/>
                        <TextBox x:Name="InstallmentsBox" Text="1" LostFocus="RecalculateMonthly_LostFocus"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="MonthlyAutoLabel"/>
                        <TextBox x:Name="MonthlyBox" IsReadOnly="True" Background="#EEE"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <Label x:Name="StartMonthLabel"/>
                        <ComboBox x:Name="StartMonthBox"/>
                    </StackPanel>
                    <StackPanel>
                        <Label x:Name="NotesLabel"/>
                        <TextBox x:Name="NotesBox"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="AutoDeductNoteText"
                           Foreground="Gray" FontStyle="Italic" FontSize="11.5" Margin="4,4,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Click="New_Click"/>
                    <Button x:Name="AddAdvanceButton" Click="AddAdvance_Click" Background="#2ECC71" Foreground="White"/>
                    <Button x:Name="MarkCompletedButton" Click="MarkCompleted_Click" Background="#3498DB" Foreground="White"/>
                    <Button x:Name="DeleteButton" Click="Delete_Click" Background="#E74C3C" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
