<UserControl x:Class="HR_ERP.Views.OrgStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="EmployeeLineTemplate">
            <TextBlock Margin="14,3,10,3" FontSize="12.5">
                <Run Text="{Binding Name}"/>
                <Run Text=" — " Foreground="Gray"/>
                <Run Text="{Binding Position}" Foreground="Gray" FontStyle="Italic"/>
            </TextBlock>
        </DataTemplate>

        <!-- One sub-department block: its own manager + employee list, nested inside the main department card.
             ManagerLabelText and EmptyText are set on each card in code-behind (localized there) rather than
             hardcoded here, since this template's controls are shared across every card instance. -->
        <DataTemplate x:Key="SubDepartmentTemplate">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="6" Margin="10,4,10,4" Padding="10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↳" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DepartmentName}" FontWeight="Bold" FontSize="12.5"/>
                        <TextBlock Text="{Binding EmployeeCountText}" Foreground="Gray" FontSize="11" Margin="8,1,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ManagerName}" FontSize="11" Foreground="{StaticResource BrandAccent}"
                               FontWeight="SemiBold" Margin="20,2,0,0" Visibility="{Binding ManagerVisibility}"/>
                    <ItemsControl ItemsSource="{Binding Employees}" ItemTemplate="{StaticResource EmployeeLineTemplate}" Margin="10,4,0,0"/>
                    <TextBlock Text="{Binding EmptyText}" Foreground="Gray" FontStyle="Italic"
                               FontSize="11" Margin="20,0,0,2" Visibility="{Binding EmptyVisibility}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="RefreshButton" Click="Refresh_Click"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem x:Name="ByDepartmentTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DepartmentsPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Main department card -->
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,10,14,14" Padding="0" Width="330" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border Background="{StaticResource BrandPrimary}" CornerRadius="8,8,0,0" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DepartmentName}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding EmployeeCountText}" Foreground="#CBD6E0" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceBrush}" Padding="12,8" Visibility="{Binding ManagerVisibility}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ManagerLabelText}" FontSize="9" Foreground="Gray" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ManagerName}" FontWeight="SemiBold" FontSize="12.5"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Employees directly in the main department (not in a sub-department) -->
                                        <ItemsControl ItemsSource="{Binding Employees}" ItemTemplate="{StaticResource EmployeeLineTemplate}" Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding EmptyText}" Foreground="Gray" FontStyle="Italic"
                                                   FontSize="11.5" Margin="14,0,10,6" Visibility="{Binding EmptyVisibility}"/>

                                        <!-- Sub-departments -->
                                        <ItemsControl ItemsSource="{Binding SubDepartments}" ItemTemplate="{StaticResource SubDepartmentTemplate}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ReportingLinesTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ReportingNoteText" Grid.Row="0"
                               Foreground="Gray" FontStyle="Italic" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TreeView x:Name="ReportingTree" BorderThickness="0" Background="Transparent">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding DirectReports}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock Text=" — " Foreground="Gray" FontSize="12.5"/>
                                        <TextBlock Text="{Binding Title}" Foreground="Gray" FontStyle="Italic" FontSize="12.5"/>
                                        <TextBlock Text="{Binding CountText}" Foreground="{StaticResource BrandAccent}" FontSize="11" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="VacantRolesTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VacantNoteText" Grid.Row="0"
                               Foreground="Gray" FontStyle="Italic" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="1" x:Name="VacantRolesGrid" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColDepartment" Binding="{Binding Department}" Width="180"/>
                            <DataGridTextColumn x:Name="ColPosition" Binding="{Binding PositionTitle}" Width="220"/>
                            <DataGridTextColumn x:Name="ColPositionCode" Binding="{Binding PositionCode}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoVacanciesText" Grid.Row="1"
                               Foreground="Gray" FontStyle="Italic" VerticalAlignment="Top" Margin="4,10,0,0" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
